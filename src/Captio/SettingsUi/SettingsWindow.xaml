<Window x:Class="Captio.SettingsUi.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuración — Captio"
        Width="600"
        Height="700"
        MinWidth="480"
        MinHeight="380"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Padding" Value="18,16" />
            <Setter Property="Margin" Value="0,0,0,14" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="2,0,0,8" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="0,14" />
            <Setter Property="Background" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- One page; the scroll bar appears only when the window is too short for the content. -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20,20,20,6">
            <StackPanel>

                <!-- General -->
                <TextBlock Text="General" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <CheckBox x:Name="LaunchAtLoginBox" Content="Iniciar Captio al iniciar sesión en Windows" Click="OnLaunchAtLoginClick" />
                        <TextBlock x:Name="LaunchAtLoginNote" Style="{StaticResource Hint}" Margin="28,2,0,0"
                                   Text="Captio se abrirá en la bandeja del sistema, sin mostrar ventanas." />

                        <Border Style="{StaticResource Divider}" />

                        <TextBlock Text="Atajo para capturar imágenes" Style="{StaticResource Label}" />
                        <TextBox x:Name="ImageHotkeyBox" Width="240" HorizontalAlignment="Left" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                 AutomationProperties.Name="Atajo para capturar imágenes" />
                        <TextBlock x:Name="HotkeyNote" Style="{StaticResource Hint}" Margin="0,6,0,0"
                                   Text="Haz clic en el campo y pulsa la nueva combinación. Si ImpPant no responde, desactiva en Windows «Usar la tecla Imprimir pantalla para abrir la captura de pantalla»." />
                    </StackPanel>
                </Border>

                <!-- Capture and saving -->
                <TextBlock Text="Captura y guardado" Style="{StaticResource SectionTitle}" Margin="2,6,0,8" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Al pulsar Enter en el editor" Style="{StaticResource Label}" />
                        <WrapPanel>
                            <RadioButton x:Name="EnterCopy" Content="Copiar" GroupName="Enter" Margin="0,0,18,0" Checked="OnEnterDestinationChanged" />
                            <RadioButton x:Name="EnterSave" Content="Guardar" GroupName="Enter" Margin="0,0,18,0" Checked="OnEnterDestinationChanged" />
                            <RadioButton x:Name="EnterImgur" Content="Subir a Imgur" GroupName="Enter" Checked="OnEnterDestinationChanged" />
                        </WrapPanel>

                        <CheckBox x:Name="CopyAlsoSavesBox" Content="Guardar automáticamente una copia al copiar" Margin="0,14,0,0" Click="OnCopyAlsoSavesClick" />

                        <Border Style="{StaticResource Divider}" />

                        <TextBlock Text="Carpeta de capturas" Style="{StaticResource Label}" />
                        <TextBlock x:Name="FolderPath" TextTrimming="CharacterEllipsis" FontFamily="Cascadia Mono, Consolas" FontSize="12" />
                        <TextBlock x:Name="FolderStatus" Style="{StaticResource Hint}" Visibility="Collapsed" />
                        <Border x:Name="LegacyBanner" Visibility="Collapsed" Margin="0,10,0,0" Padding="12" CornerRadius="6" BorderThickness="1"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                            <StackPanel>
                                <TextBlock TextWrapping="Wrap"
                                           Text="Tus capturas siguen en la carpeta privada de la versión anterior. Puedes moverlas a la carpeta de capturas de Windows cuando quieras." />
                                <Button Content="Mover a la carpeta de capturas de Windows" HorizontalAlignment="Left" Margin="0,8,0,0" Click="OnReset" />
                            </StackPanel>
                        </Border>
                        <WrapPanel Margin="0,10,0,0">
                            <Button Content="Elegir…" MinWidth="92" Margin="0,0,8,0" Click="OnChooseFolder" />
                            <Button x:Name="ResetButton" Content="Restablecer" MinWidth="92" Margin="0,0,8,0" Click="OnReset"
                                    ToolTip="Volver a la carpeta de capturas de pantalla de Windows" />
                            <Button x:Name="OpenFolderButton" Content="Abrir carpeta" MinWidth="92" Click="OnOpenFolder" />
                        </WrapPanel>

                        <Border Style="{StaticResource Divider}" />

                        <TextBlock Text="Orientación de la barra" Style="{StaticResource Label}" />
                        <WrapPanel x:Name="OrientationPanel" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                   Text="Lado preferido junto a la selección, centrada respecto a ella. Si no cabe, la barra usa el lado opuesto." />
                    </StackPanel>
                </Border>

                <!-- Imgur -->
                <TextBlock Text="Imgur" Style="{StaticResource SectionTitle}" Margin="2,6,0,8" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock x:Name="ImgurStatus" TextWrapping="Wrap" />
                        <WrapPanel Margin="0,12,0,0">
                            <Button Content="Ver aviso de privacidad" Click="OnShowNotice" Margin="0,0,8,0" />
                            <Button x:Name="RevokeButton" Content="Retirar consentimiento" Click="OnRevoke" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Padding="20,12">
            <Button Content="Cerrar" MinWidth="96" HorizontalAlignment="Right" IsCancel="True" Click="OnClose" />
        </Border>
    </Grid>
</Window>
