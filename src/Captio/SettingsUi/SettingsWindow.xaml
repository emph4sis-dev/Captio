<Window x:Class="Captio.SettingsUi.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuración — Captio"
        Width="520"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="24">
        <TextBlock Text="Atajos" FontSize="16" FontWeight="SemiBold" />
        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="Capturar imagen" VerticalAlignment="Center" />
            <TextBox x:Name="ImageHotkeyBox" Grid.Column="1" IsReadOnly="True" IsReadOnlyCaretVisible="False" />
            <TextBlock Grid.Row="1" Text="Grabar clip" VerticalAlignment="Center" Margin="0,8,0,0" />
            <TextBox x:Name="ClipHotkeyBox" Grid.Row="1" Grid.Column="1" IsReadOnly="True" IsReadOnlyCaretVisible="False" Margin="0,8,0,0" />
        </Grid>
        <TextBlock TextWrapping="Wrap" Opacity="0.7" Margin="0,8,0,0" FontSize="12"
                   Text="Haz clic en un campo y pulsa la nueva combinación. Si ImpPant no responde, desactiva en Windows «Usar la tecla Imprimir pantalla para abrir la captura de pantalla»." />

        <TextBlock Text="Al pulsar Enter en el editor" FontSize="16" FontWeight="SemiBold" Margin="0,24,0,0" />
        <RadioButton x:Name="EnterCopy" Content="Copiar al portapapeles" GroupName="Enter" Margin="0,8,0,0" />
        <RadioButton x:Name="EnterSave" Content="Guardar en la biblioteca" GroupName="Enter" Margin="0,4,0,0" />
        <RadioButton x:Name="EnterImgur" Content="Subir a Imgur" GroupName="Enter" Margin="0,4,0,0" />

        <TextBlock Text="Imgur" FontSize="16" FontWeight="SemiBold" Margin="0,24,0,0" />
        <TextBlock x:Name="ImgurStatus" TextWrapping="Wrap" Margin="0,8,0,0" />
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="Ver aviso de privacidad" Click="OnShowNotice" Margin="0,0,8,0" />
            <Button x:Name="RevokeButton" Content="Retirar consentimiento" Click="OnRevoke" />
        </StackPanel>

        <TextBlock Text="Biblioteca" FontSize="16" FontWeight="SemiBold" Margin="0,24,0,0" />
        <DockPanel Margin="0,8,0,0">
            <Button DockPanel.Dock="Right" Content="Abrir carpeta" Click="OnOpenLibraryFolder" Margin="8,0,0,0" />
            <TextBlock x:Name="LibraryPath" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Opacity="0.8" />
        </DockPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,28,0,0">
            <Button Content="Guardar" MinWidth="96" Margin="0,0,8,0" IsDefault="True" Click="OnSave" Style="{DynamicResource AccentButtonStyle}" />
            <Button Content="Cancelar" MinWidth="96" IsCancel="True" Click="OnCancel" />
        </StackPanel>
    </StackPanel>
</Window>
