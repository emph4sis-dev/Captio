<Window x:Class="Captio.SettingsUi.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuración — Captio"
        Width="680"
        SizeToContent="Height"
        MinWidth="560"
        MinHeight="420"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- Layout: one divided panel per group, rows of title + description on the left and the control on the right. -->
        <Style x:Key="GroupTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="2,28,0,8" />
        </Style>
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        </Style>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Margin" Value="18,14" />
            <Setter Property="MinHeight" Value="40" />
        </Style>
        <Style x:Key="RowDivider" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        </Style>
        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style x:Key="RowDescription" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="RowWarning" TargetType="TextBlock" BasedOn="{StaticResource RowDescription}">
            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>

        <!-- Windows 11 style switch for on/off settings. -->
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <TextBlock x:Name="State" Text="Desactivado" VerticalAlignment="Center" Margin="0,0,12,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <Border x:Name="Track" Width="40" Height="20" CornerRadius="10" BorderThickness="1"
                                    BorderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}"
                                    Background="{DynamicResource ControlAltFillColorSecondaryBrush}">
                                <Ellipse x:Name="Thumb" Width="12" Height="12" Margin="4,0" HorizontalAlignment="Left"
                                         Fill="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Border>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="State" Property="Text" Value="Activado" />
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Thumb" Property="Width" Value="14" />
                                <Setter TargetName="Thumb" Property="Height" Value="14" />
                                <Setter TargetName="Thumb" Property="Margin" Value="3,0" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Two-option segmented control. -->
        <Style x:Key="Segment" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="MinWidth" Value="84" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Chrome" CornerRadius="4" Padding="12,5" Margin="2" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One tile per toolbar side; the content is a drawing of the real toolbar. -->
        <Style x:Key="SideTile" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Chrome" Width="68" Padding="0,8,0,6" CornerRadius="6" BorderThickness="1"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
                                <Setter TargetName="Chrome" Property="Padding" Value="0,7,0,5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The hotkey looks like a key, not like a text field: click it, then press the new combination. -->
        <Style x:Key="KeyCap" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="5" Padding="12,5" BorderThickness="1,1,1,2"
                                BorderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}"
                                Background="{DynamicResource ControlFillColorDefaultBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: the product's mark, so the window belongs to Captio. -->
        <StackPanel Orientation="Horizontal" Margin="28,22,28,4">
            <Border Width="34" Height="34" CornerRadius="8" Background="#4F5BD5" VerticalAlignment="Center">
                <Canvas Width="34" Height="34">
                    <Path Stroke="White" StrokeThickness="2.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Data="M 9,15 L 9,9 L 15,9 M 19,25 L 25,25 L 25,19" />
                    <Ellipse Width="4" Height="4" Fill="White" Canvas.Left="15" Canvas.Top="15" />
                </Canvas>
            </Border>
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Configuración" FontSize="20" FontWeight="SemiBold" />
                <TextBlock x:Name="VersionText" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,0,28,24"
                      Focusable="False">
            <StackPanel>

                <!-- Capture: how a capture starts and how the editor behaves. -->
                <TextBlock Text="Captura" Style="{StaticResource GroupTitle}" Margin="2,18,0,8" />
                <Border Style="{StaticResource Panel}">
                    <StackPanel>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Atajo de captura" Style="{StaticResource RowTitle}" />
                                <TextBlock x:Name="HotkeyDescription" Style="{StaticResource RowDescription}"
                                           Text="Congela la pantalla para elegir una zona." />
                                <TextBlock x:Name="HotkeyWarning" Style="{StaticResource RowWarning}" />
                            </StackPanel>
                            <Button x:Name="HotkeyButton" Grid.Column="1" Style="{StaticResource KeyCap}" VerticalAlignment="Center"
                                    Click="OnHotkeyClick" AutomationProperties.Name="Atajo de captura" />
                        </Grid>
                        <Border Style="{StaticResource RowDivider}" />

                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Al pulsar Enter" Style="{StaticResource RowTitle}" />
                                <TextBlock Style="{StaticResource RowDescription}" Text="Lo que hace Enter al terminar de editar." />
                            </StackPanel>
                            <Border Grid.Column="1" CornerRadius="6" BorderThickness="1" VerticalAlignment="Center"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    Background="{DynamicResource ControlAltFillColorSecondaryBrush}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="EnterCopy" Content="Copiar" GroupName="Enter" Style="{StaticResource Segment}" Checked="OnEnterDestinationChanged" />
                                    <RadioButton x:Name="EnterSave" Content="Guardar" GroupName="Enter" Style="{StaticResource Segment}" Checked="OnEnterDestinationChanged" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Border Style="{StaticResource RowDivider}" />

                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Barra de edición" Style="{StaticResource RowTitle}" />
                                <TextBlock Style="{StaticResource RowDescription}"
                                           Text="Lado de la selección donde aparece. Si no cabe, usa el opuesto." />
                            </StackPanel>
                            <StackPanel x:Name="OrientationPanel" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Saving: where captures end up. -->
                <TextBlock Text="Guardado" Style="{StaticResource GroupTitle}" />
                <Border Style="{StaticResource Panel}">
                    <StackPanel>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Carpeta de capturas" Style="{StaticResource RowTitle}" />
                                <TextBlock x:Name="FolderPath" Style="{StaticResource RowDescription}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="FolderStatus" Style="{StaticResource RowWarning}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Elegir…" MinWidth="80" Click="OnChooseFolder" />
                                <Button x:Name="OpenFolderButton" Margin="6,0,0,0" Padding="8,5" Click="OnOpenFolder"
                                        ToolTip="Abrir la carpeta" AutomationProperties.Name="Abrir la carpeta">
                                    <TextBlock Text="&#xE8DA;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Shown only while the folder is not the Windows default. -->
                        <Grid x:Name="ResetRow" Style="{StaticResource Row}" Margin="18,0,18,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ResetText" Style="{StaticResource RowDescription}" VerticalAlignment="Center" Margin="0,0,16,0"
                                       Text="Usas una carpeta personalizada." />
                            <Button x:Name="ResetButton" Grid.Column="1" Click="OnReset" VerticalAlignment="Center"
                                    Content="Volver a la de Windows" />
                        </Grid>
                        <Border Style="{StaticResource RowDivider}" />

                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Guardar también al copiar" Style="{StaticResource RowTitle}" />
                                <TextBlock Style="{StaticResource RowDescription}" Text="Ctrl+C copia la imagen y además la guarda en la carpeta." />
                            </StackPanel>
                            <CheckBox x:Name="CopyAlsoSavesBox" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center"
                                      Click="OnCopyAlsoSavesClick" AutomationProperties.Name="Guardar también al copiar" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- System: set once and forgotten. -->
                <TextBlock Text="Sistema" Style="{StaticResource GroupTitle}" />
                <Border Style="{StaticResource Panel}">
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Iniciar con Windows" Style="{StaticResource RowTitle}" />
                            <TextBlock Style="{StaticResource RowDescription}" Text="Captio arranca en la bandeja, sin abrir ventanas." />
                            <TextBlock x:Name="LaunchAtLoginWarning" Style="{StaticResource RowWarning}" />
                        </StackPanel>
                        <CheckBox x:Name="LaunchAtLoginBox" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center"
                                  Click="OnLaunchAtLoginClick" AutomationProperties.Name="Iniciar con Windows" />
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- One save model: every change applies itself; the footer confirms it. -->
        <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Padding="28,12">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Cerrar" MinWidth="96" IsCancel="True" Click="OnClose" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="SavedGlyph" Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                               VerticalAlignment="Center" Margin="0,0,6,0" Visibility="Collapsed"
                               Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                    <TextBlock x:Name="SavedText" FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="Los cambios se aplican al momento." />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
