<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The PerMonitorV2 manifest is required by WPF; the WinForms tray icon shares it. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <RootNamespace>Captio</RootNamespace>
    <AssemblyName>Captio</AssemblyName>
    <!-- Public, non-secret Client-ID of the registered Imgur application.
         Pass it at build time: dotnet build -p:ImgurClientId=xxxx -->
    <ImgurClientId Condition="'$(ImgurClientId)' == ''"></ImgurClientId>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>ImgurClientId</_Parameter1>
      <_Parameter2>$(ImgurClientId)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Captio.Core\Captio.Core.csproj" />
  </ItemGroup>

</Project>
