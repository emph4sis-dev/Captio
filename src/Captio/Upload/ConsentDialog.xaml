<Window x:Class="Captio.Upload.ConsentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Subir a Imgur"
        Width="460"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Topmost="True">
    <StackPanel Margin="24">
        <TextBlock Text="Antes de subir a Imgur" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />
        <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="21">
            Esta imagen se enviará a Imgur. No aparecerá públicamente en su comunidad, pero cualquiera con el enlace podrá verla. Captio no conservará el archivo, el enlace ni la clave necesaria para eliminarlo posteriormente.
        </TextBlock>
        <TextBlock TextWrapping="Wrap" Margin="0,12,0,0" Opacity="0.75">
            Imgur puede comprimir o convertir imágenes grandes, y Captio no puede garantizar cuánto tiempo seguirá disponible el enlace.
        </TextBlock>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button x:Name="AcceptButton" Content="Acepto, subir" MinWidth="120" Margin="0,0,8,0" Click="OnAccept" Style="{DynamicResource AccentButtonStyle}" />
            <Button x:Name="CancelButton" Content="Cancelar" MinWidth="96" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
